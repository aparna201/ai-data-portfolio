          }
        ]
      ]
    },
    "Needs Human?": {
      "main": [
        [
          {
            "node": "Send Team Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
